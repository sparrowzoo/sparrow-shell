                <artifactId>authenticator-passport-starter</artifactId>
                <version>${authenticator-passport-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sparrowzoo</groupId>
                <artifactId>authenticator-monolithic-starter</artifactId>
                <version>${authenticator-monolithic-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sparrowzoo</groupId>
                <artifactId>authenticator-microservice-starter</artifactId>
                <version>${authenticator-microservice-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sparrowzoo</groupId>
                <artifactId>authenticator-gateway-api</artifactId>
                <version>${authenticator-gateway-api.version}</version>
            </dependency>
